# Eye of Atlas — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST NEVER be committed.
# Real values live only in your local `.env` and in the provider dashboards
# (Cloudflare Workers secrets, Google Cloud, NASA FIRMS).
#
# Keep this file current whenever a key is added or removed (master plan §28.10).
#
# ─────────────────────────────────────────────────────────────────────────────
# TWO CLASSES OF KEY — the distinction matters
# ─────────────────────────────────────────────────────────────────────────────
#   CLIENT-EXPOSED : compiled into the browser bundle. Visible in devtools by
#                    design. Protect with provider-side restrictions + quotas,
#                    NOT by hiding. (Same model as a Mapbox public token.)
#   SERVER-ONLY    : held by the Cloudflare Worker. Never reaches the browser.
#                    Set via `wrangler secret put NAME`, never in wrangler.toml.
# ═════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# CLIENT-EXPOSED
# ─────────────────────────────────────────────────────────────────────────────

# Google Maps API key — REQUIRED. Powers Photorealistic 3D Tiles (the globe).
#
# The app does not boot without this. It is inlined into the bundle on purpose:
# see docs/STAGE0-CHANGE-PLAN.md §3.1 for why we do NOT proxy 3D Tiles.
#
# BEFORE USING THIS KEY IN ANY DEPLOYED BUILD, in Google Cloud Console:
#   1. Application restriction → HTTP referrers → your domains only
#   2. API restriction        → Map Tiles API only (use a SEPARATE key for
#                               Geocoding, which is server-side — see below)
#   3. APIs & Services → Quotas → set a HARD daily cap on Map Tiles
#   4. Billing → Budgets & alerts → set a budget with email alerts
# Steps 3 and 4 are the real spend control. Referrer restriction is spoofable.
#
# Pricing (verified 2026-09-01): Photorealistic 3D Tiles bills per *root
# tileset query* (≈ per session), NOT per tile — 1,000/month free, then
# $6.00/1,000. Renderer-originating tile requests are not billable.
GOOGLE_MAPS_API_KEY=

# ArcGIS Location Platform API key — the Esri satellite basemap.
#
# WITHOUT IT the Esri stack is unavailable and the keyless landing is OSM.
# OSM is a DEVELOPMENT fallback only: the OSM Foundation's tile policy says
# access may be withdrawn without notice and is unsuitable for high-traffic
# commercial services. A production deploy should set this key.
#
# ⚠️ Do NOT go back to the keyless services.arcgisonline.com endpoint. It is
#    governed by the Esri Master License Agreement, whose Terms of Use §2.2
#    limit it to Noncommercial Use — defined as provided at no charge AND
#    generating no income. Ads generate income. See COMMERCIAL_COMPLIANCE.md
#    §6.6. ArcGIS Location Platform is a separate service that carries a
#    commercial deployment licence.
#
# Free tier: 2,000,000 basemap tiles/month (or 1,000 basemap sessions),
# no credit card. Get one at https://location.arcgis.com/
#
# CLIENT-EXPOSED — restrict it by referrer in the ArcGIS portal rather than
# trying to hide it. Attribution is mandatory (Agreement E204 §3.1(d)(4)) and
# tiles must not be cached beyond their caching headers (§3.1(d)(6)), which is
# why basemaps are never routed through our Worker.
#
# ⚠️ THE APP CANNOT VALIDATE THIS KEY. Measured 2026-09-01: the endpoint serves
#    full imagery even for an obviously invalid token. Tiles rendering is NOT
#    evidence of a valid subscription — licensing here is contractual, not
#    technically enforced. Make sure this is a real Location Platform key.
# DEPLOYMENT: this is a BUILD-time variable, not a runtime one. Vite inlines it
# during `npm run build`, so it must be set in the Cloudflare project's BUILD
# variables (Settings -> Build). Setting it under "Variables and Secrets"
# (runtime) does nothing — nothing reads it there — and those entries are wiped
# on every deploy anyway, because `wrangler deploy` syncs runtime bindings from
# wrangler.toml. See the block in wrangler.toml for the full explanation.
ARCGIS_API_KEY=

# Cesium ion token — OPTIONAL. Only needed for Bing imagery / Cesium World Terrain.
#
# ⚠️ Cesium ion's ToS is AMBIGUOUS for a public ad-supported product
#    (COMMERCIAL_COMPLIANCE.md §2.2 — reclassified Class E, unresolved).
#    Leave this UNSET until that is settled. If it is ever enabled, the
#    "Cesium ion" logo must be prominently displayed.
# Use a public `assets:read` token with URL restrictions.
CESIUM_ION_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY — Cloudflare Worker secrets
# Set with:  wrangler secret put <NAME>       (never commit real values)
# ─────────────────────────────────────────────────────────────────────────────

# NASA FIRMS map key — active wildfire detections (P1 layer).
# Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Limit: 5,000 transactions / 10-minute interval. Worker caches 30 min.
FIRMS_MAP_KEY=

# Google Geocoding API key — location search (P0 feature).
# Keep this SEPARATE from GOOGLE_MAPS_API_KEY above: this one is server-side
# and must be restricted to the Geocoding API with NO referrer restriction
# (Worker requests have no browser referrer). Set an IP restriction if you
# pin egress, otherwise rely on the quota cap.
# Pricing (verified 2026-09-01): 10,000/month free, then $5.00/1,000.
GOOGLE_GEOCODING_API_KEY=

# Google Gemini API key — Ask Atlas (STAGE 3, not used yet).
# ⚠️ On the FREE tier Google uses submitted content to improve its products and
#    human reviewers may read it (COMMERCIAL_COMPLIANCE.md §2.3). This must be
#    disclosed in the privacy policy before Ask Atlas ships, and no user
#    identifiers or precise location may ever be sent.
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# WORKER CONFIGURATION (non-secret — mirrored in workers/api-proxy/wrangler.toml)
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated origin allowlist for the Worker's CORS + origin check.
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# Per-source daily budget caps (UTC day). Over cap the Worker serves cached
# data, or returns 503 {status:"layer-paused"} — never unbounded spend.
BUDGET_GEOCODE_PER_DAY=300
BUDGET_FIRMS_PER_DAY=500
BUDGET_CELESTRAK_PER_DAY=12
BUDGET_FLIGHTS_PER_DAY=5000
BUDGET_PING_PER_DAY=1000

# Per-IP rate limits (requests per minute), keyed on CF-Connecting-IP.
RATELIMIT_GEOCODE_PER_MIN=20
RATELIMIT_FIRMS_PER_MIN=10
RATELIMIT_CELESTRAK_PER_MIN=10
RATELIMIT_FLIGHTS_PER_MIN=30
RATELIMIT_PING_PER_MIN=10


# ─────────────────────────────────────────────────────────────────────────────
# DEPRECATED / DELIBERATELY ABSENT — do not reintroduce
# ─────────────────────────────────────────────────────────────────────────────
# OPENSKY_*        Non-commercial licence; prohibits ad-supported use.
#                  Replaced by adsb.lol.        (COMMERCIAL_COMPLIANCE.md §3.4)
# OPENAI_API_KEY   Voice AI dropped from v1; Ask Atlas is text-only on Gemini.
# AISSTREAM_*      No formal ToS + direct browser connections prohibited;
#                  would require Durable Objects. Ships are out of Stage 1.
# TOMTOM_API_KEY   Traffic cut from MVP (Class C).
# (No Open-Meteo key exists — it is keyless — but weather is cut from MVP:
#  its free API forbids ad-supported use.)
